mainmenu "Waveshare ESP-NOW Peer"

menu "ESP-NOW Configuration"

choice ESPNOW_NODE_ROLE
	prompt "Node identity"
	default ESPNOW_NODE_ROLE_MASTER

config ESPNOW_NODE_ROLE_MASTER
	bool "Master"

config ESPNOW_NODE_ROLE_SLAVE
	bool "Slave"

endchoice

config ESPNOW_MASTER_LED_BRIGHTNESS
	int "Master RGB LED brightness"
	range 0 255
	default 8

config ESPNOW_SLAVE_LED_BRIGHTNESS
	int "Slave RGB LED brightness"
	range 0 255
	default 2

config ESPNOW_LED_EVENT_DURATION_MS
	int "ESP-NOW TX/RX color duration in milliseconds"
	range 20 1000
	default 180
	help
	  TX is shown in red and RX in green. Events are queued so both colors
	  remain visible when transmit and receive happen close together.

config CAR_CONTROL_TIMEOUT_MS
	int "Car failsafe timeout in milliseconds"
	range 200 5000
	default 700
	help
	  The car-side ESP sends STOP to the TI MCU if no valid control command
	  arrives within this period while the car is moving.

menu "TI UART Link"
	depends on ESPNOW_NODE_ROLE_SLAVE

config TI_UART_BAUD_RATE
	int "TI UART baud rate"
	range 1200 3000000
	default 460800
	help
	  Runtime baud rate for the ESP master UART1 connection to the TI MCU.

config TI_UART_STATUS_INTERVAL_MS
	int "Status message interval in milliseconds"
	range 100 60000
	default 1000
	help
	  Interval of the car-side ESP,ALIVE status line sent to the TI MCU.

endmenu

menu "WitMotion IMU UART"
	depends on ESPNOW_NODE_ROLE_SLAVE

config IMU_UART_BAUD_RATE
	int "IMU UART baud rate"
	range 1200 921600
	default 9600
	help
	  UART0 baud rate for the WitMotion 0x55 binary protocol.

config IMU_UART_STALE_TIMEOUT_MS
	int "IMU stale timeout in milliseconds"
	range 100 2000
	default 300
	help
	  Report an IMU fault when valid gyro and angle frames are not both
	  received within this interval.

endmenu

choice ESPNOW_ROLE
	prompt "Device role"
	default ESPNOW_ROLE_BIDIR

config ESPNOW_ROLE_SENDER
	bool "Sender"

config ESPNOW_ROLE_RECEIVER
	bool "Receiver"

config ESPNOW_ROLE_BIDIR
	bool "Both (send and receive)"

endchoice

config ESPNOW_CHANNEL
	int "Wi-Fi channel"
	range 1 13
	default 6
	help
	  Both devices must use the same channel.

config ESPNOW_BEACON_INTERVAL_S
	int "Beacon interval in seconds"
	range 1 60
	default 2
	depends on ESPNOW_ROLE_SENDER || ESPNOW_ROLE_BIDIR

endmenu

source "Kconfig.zephyr"
