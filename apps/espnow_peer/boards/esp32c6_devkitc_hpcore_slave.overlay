/*
 * Slave-only IMU UART routing.
 *
 * UART0 defaults to GPIO16/17, which are also connected to the onboard
 * USB-to-UART bridge.  Route the application UART to GPIO2/3 so the bridge
 * and the IMU never drive the same RX signal.
 */

#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>

/ {
	aliases {
		imu-uart = &uart0;
	};

	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};
};

&pinctrl {
	imu_uart_default: imu_uart_default {
		group1 {
			pinmux = <UART0_TX_GPIO2>;
			output-high;
		};

		group2 {
			pinmux = <UART0_RX_GPIO3>;
			bias-pull-up;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&imu_uart_default>;
	pinctrl-names = "default";
};
